<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Cricket</string>
	<key>CFBundleDisplayName</key>
	<string>Cricket</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Cricket needs Bluetooth to connect to your environmental sensors (Arduino or RuuviTag) for hyperlocal temperature and humidity monitoring.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Cricket connects to BLE environmental sensors to provide hyperlocal climate data.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>AppIcon</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>GetLocalTemperatureIntent</string>
		<string>GetLocalHumidityIntent</string>
		<string>GetSensorStatusIntent</string>
	</array>
	<key>NSSiriUsageDescription</key>
	<string>Cricket uses Siri to let you ask for temperature, humidity, and sensor status hands-free.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
</dict>
</plist>
